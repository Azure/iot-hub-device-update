                "connectionX509CertFilePath": "/etc/adu/certs/[leaf-cert].pem",
                "connectionX509PrivateKeyFilePath": "/etc/adu/certs/[leaf-key].key",
                "connectionX509CaCertFilePath": "/etc/adu/certs/[ca-cert].pem"
            },
            "manufacturer": "Contoso",
            "model": "Smart-Box",
            "IdlePauseMilliseconds": "300000" 
        }
    ]
}