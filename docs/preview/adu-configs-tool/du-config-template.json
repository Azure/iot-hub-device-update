{
    "schemaVersion": "1.2",
    "aduShellTrustedUsers": ["adu", "do"],
    "manufacturer": "device_info_manufacturer",
    "model": "device_info_model",
    "agents": [
        {
            "name": "host-update",
            "runas": "adu",
            "connectionSource": {
