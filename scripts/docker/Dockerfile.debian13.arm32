# Dockerfile for ADU Agent build environment
# Target: Debian 13 (Trixie) ARM32
#
# Installs all prerequisites assumed by install-deps.sh so the script
# (and subsequent builds) can run without missing tools or libraries.
#
# Build (on an arm32 host or with buildx):
#   docker buildx build --platform linux/arm/v7 \
#       -f Dockerfile.debian13.arm32 -t adu-build:debian13-arm32 .

FROM arm32v7/debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

# ── 1. Basic utilities the script assumes are present ─────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        sudo \
        bash \
        ca-certificates \
        lsb-release \
        gnupg \
        apt-transport-https \
        software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# ── 2. ADU Agent package dependencies (aduc_packages in install-deps.sh) ──────
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        make \
        build-essential \
        cmake \
        ninja-build \
        libcurl4-openssl-dev \
        libssl-dev \
        uuid-dev \
        curl \
        wget \
        pkg-config \
        libxml2-dev \
        file \
    && rm -rf /var/lib/apt/lists/*

# ── 3. Debian 13 specific compilers (uses gcc-12 per install-deps.sh) ────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-12 \
        g++-12 \
    && rm -rf /var/lib/apt/lists/*

# ── 4. Static-analysis packages ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang \
        clang-tidy \
        cppcheck \
    && rm -rf /var/lib/apt/lists/*

# ── 5. Shellcheck build dependencies (built from source on arm32) ─────────────
# Note: DO (Delivery Optimization) is skipped on Debian 13 by install-deps.sh,
#       so libboost-filesystem-dev/libboost-system-dev are not required.
RUN apt-get update && apt-get install -y --no-install-recommends \
        cabal-install \
    && rm -rf /var/lib/apt/lists/*

# ── 6. Valgrind build-from-source dependencies ───────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        libtool \
    && rm -rf /var/lib/apt/lists/*

# ── 7. Directories the script / build expect ─────────────────────────────────
RUN mkdir -p /usr/local/inc /usr/local/pal/linux /tmp/adu

# ── 8. Set default compilers ─────────────────────────────────────────────────
ENV CC=/usr/bin/gcc-12
ENV CXX=/usr/bin/g++-12

# ── 9. Workspace directory ───────────────────────────────────────────────────
WORKDIR /src
